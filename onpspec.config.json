{
  "testCommand": "pytest",
  "reporter": "exitcode",
  "ignoreGlobs": [
    "**/__pycache__/**",
    "**/*.pyc",
    ".pytest_cache/**",
    ".venv/**",
    "node_modules/**",
    ".git/**",
    ".spec/**",
    "*.sqlite3",
    "*.log"
  ],
  "testGlobs": [
    "tests/**",
    "apps/**/tests.py",
    "apps/**/tests/*.py",
    "apps/**/tests/**/*.py",
    "apps/**/test_*.py"
  ],
  "srcGlobs": [
    "apps/**",
    "config/**",
    "manage.py"
  ]
}
