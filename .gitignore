# ==============================================================================
# SISTEMA XPTO INVESTIMENTOS — .gitignore
# ==============================================================================

# Python bytecode e caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc

# Ambientes virtuais (Virtual Environments)
.venv/
.venv*/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribuição e builds
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
backups/

# Variáveis de ambiente e segredos (NUNCA versionar)
.env
.env.local
.env.*.local
*.pem
*.key

# Testes, Cobertura e Cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
nosetests.xml
coverage.xml

# Node.js e ferramentas CLI (usado pelo onp-spec)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editores e IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject

# Sistema Operacional (macOS e Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporários
tmp/
temp/
*.tmp
